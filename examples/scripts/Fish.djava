import pixelbot.components.generic.HighlightScreen.IHighlight;
import pixelbot.misc.*;
import pixelbot.script.general.*;
import pixelbot.script.helper.IOHelper;
import pixelbot.script.misc.ScopeClassifierItem;
import pixelbot.script.scope.java.*;

public class Fish implements INativeJob {
	private static final int POOL_MIN_SIZE = 1000;
	private NativeMap context;
	private IOHelper helper;

	@Override
	public void setContext(NativeMap context) {
		this.context = context;
		this.helper = (IOHelper) context.getNative("Helper");
	}

	private IConfiguration config = new IConfiguration() {

		@Override
		public boolean active() {
			return true;
		}

		@Override
		public NativeList config(NativeMap params) throws InterruptedException {

			NativeList config = new NativeList();

			NativeList p = (NativeList) Fish.this.context.getMap("HHTools").getMap("params")
					.invoke("config", params);

			config.addAll(p);

			HashMap<String, Object> map = null;
			List<Map<String, Object>> list = null;

			map = new HashMap<String, Object>();
			list = new ArrayList<Map<String, Object>>();
			map.put("name", "pool");
			map.put("label", "Водоем");
			map.put("type", "group");
			map.put("values", list);
			config.add(map);

			map = new HashMap<String, Object>();
			map.put("name", "pool_location");
			map.put("label", "Расположение водоема");
			map.put("type", "radio");
			map.put("values",
					Arrays.asList(new String[] { "Искать озеро", "Указать расположение",
							"Ловить в реке", "Не трогать" }));
			list.add(map);

			map = new HashMap<String, Object>();
			map.put("name", "pool_location_x");
			map.put("label", "Горизоталь");
			map.put("type",
					params.get("pool") != null
							&& "Указать расположение".equals(((Map<?, ?>) params.get("pool"))
									.get("pool_location")) ? "slider" : "hidden");
			map.put("values",
					Arrays.asList(new Integer[] { Integer.valueOf(1), Integer.valueOf(0),
							Integer.valueOf(1) }));
			list.add(map);

			map = new HashMap<String, Object>();
			map.put("name", "pool_location_y");
			map.put("label", "Вертикаль");
			map.put("type",
					params.get("pool") != null
							&& "Указать расположение".equals(((Map<?, ?>) params.get("pool"))
									.get("pool_location")) ? "slider" : "hidden");
			map.put("values",
					Arrays.asList(new Integer[] { Integer.valueOf(1), Integer.valueOf(0),
							Integer.valueOf(100) }));
			list.add(map);

			map = new HashMap<String, Object>();
			map.put("name", "pool_type");
			map.put("label", "Вид водоема");
			map.put("type", "radio");
			map.put("values", Arrays.asList(new String[] { "Вода", "Лава" }));
			list.add(map);

			map = new HashMap<String, Object>();
			map.put("name", "pool_coastline");
			map.put("label", "Смещение береговой линии");
			map.put("type", "slider");
			map.put("values",
					Arrays.asList(new Integer[] { Integer.valueOf(1), Integer.valueOf(-100),
							Integer.valueOf(100) }));
			list.add(map);

			map = new HashMap<String, Object>();
			list = new ArrayList<Map<String, Object>>();
			map.put("name", "resource");
			map.put("label", "Ресурс");
			map.put("type", "group");
			map.put("values", list);
			config.add(map);

			map = new HashMap<String, Object>();
			map.put("name", "mode");
			map.put("label", "Режим работы");
			map.put("type", "radio");
			map.put("values", Arrays.asList(new String[] { "Класс рыбы", "Название рыбы" }));
			list.add(map);

			HashSet<IClassifierItem> types = new HashSet<IClassifierItem>();
			List<IClassifierItem> fishes = Fish.this.helper.getElementsDesc("ресурсы.рыба");
			for (IClassifierItem f : fishes) {
				String type = f.getText().substring(0, f.getText().indexOf('.'));
				types.add(new ScopeClassifierItem(f.getOrder(), type));
			}

			IClassifierItem[] types_array = types.toArray(new IClassifierItem[] {});
			Arrays.sort(types_array);

			map = new HashMap<String, Object>();
			map.put("name", "fish_types");
			map.put("label", "Класс рыбы");
			map.put("type",
					params.get("resource") != null
							&& "Класс рыбы".equals(((Map<?, ?>) params.get("resource")).get("mode"))
							? "selector" : "hidden");
			map.put("values", Arrays.asList(types_array));
			list.add(map);

			map = new HashMap<String, Object>();
			map.put("name", "fish_names");
			map.put("label", "Название рыбы");
			map.put("type",
					params.get("resource") != null
							&& "Название рыбы".equals(((Map<?, ?>) params.get("resource"))
									.get("mode")) ? "selector" : "hidden");
